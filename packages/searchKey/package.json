{
  "name": "@js-to-ts-interfaces/search-key",
  "version": "0.1.0",
  "private": false,
  "description": "在任意網頁注入 $searchKey() 以搜尋全域/框架掛載節點路徑。",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run bundle",
    "bundle": "esbuild main.ts --bundle --format=iife --outfile=dist/bundle.js --sourcemap --footer:js=\"window.injectSearchKey=SearchKeyModule.injectSearchKey;\"",
    "clean": "rimraf dist"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE*"
  ],
  "license": "MIT",
  "dependencies": {
    "@js-to-ts-interfaces/core": "workspace:core"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.6.3"
  }
}
